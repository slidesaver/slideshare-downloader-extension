{
  "manifest_version": 3,
  "name": "SlideShare Downloader – PDF, PPT & Scribd",
  "short_name": "SlideShare DL",
  "version": "1.0.0",
  "description": "Download public SlideShare presentations as PDF, PPT or images, plus Scribd documents. Free, no login.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SlideShare Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "clipboardWrite"
  ],
  "homepage_url": "https://slidesharedownloadr.com/"
}